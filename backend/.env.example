DATABASE_URL=postgresql://lumiere:REPLACE_ME@localhost:5432/lumiere
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# SMTP is optional for local development; required for real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: all three required, test mode only. Never commit actual values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin MFA: production always requires enrollment; optional strict development mode.
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_ENCRYPTION_KEY=

# Optional Cloudinary image uploads (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Explicit local test-only COD; disabled in production.
COD_TEST_ENABLED=false

# Optional simulated shipping, disabled by default and in production.
SHIPPING_TEST_ENABLED=false

# Order notifications: explicit local test recipients only; no production sending.
ORDER_EMAIL_TEST_ENABLED=false
ORDER_EMAIL_TEST_RECIPIENT=
ORDER_WHATSAPP_TEST_ENABLED=false
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_PACKING=
WHATSAPP_TEMPLATE_SHIPPED=
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_CANCELLED=
